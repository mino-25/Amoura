# Copier ce fichier en ".env" à la racine avant de lancer `docker compose up`.

APP_ENV=dev
DB_PASSWORD=!ChangeMe!
DB_ROOT_PASSWORD=!ChangeMeRoot!

# En local, Mailpit intercepte les emails (consultables sur http://localhost:8025).
# En production, utiliser un DSN Mailjet ou SendGrid, ex:
# MAILER_DSN=mailjet+smtp://PUBLIC_KEY:PRIVATE_KEY@default
MAILER_DSN=smtp://mailer:1025

# Copier ce fichier en ".env.prod" sur le serveur cible avant de lancer
# `docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build`.
# Ne JAMAIS committer le fichier ".env.prod" réel (il est dans .gitignore).

# --- Base de données ---
DB_PASSWORD=CHANGE_MOI_MOT_DE_PASSE_FORT
DB_ROOT_PASSWORD=CHANGE_MOI_MOT_DE_PASSE_ROOT_FORT

# --- Symfony ---
# Générer avec : php -r 'echo bin2hex(random_bytes(16));'
APP_SECRET=CHANGE_MOI_SECRET_ALEATOIRE

# Généré une seule fois via :
#   docker compose -f docker-compose.prod.yml exec backend \
#     php bin/console lexik:jwt:generate-keypair
# La phrase doit correspondre à celle utilisée lors de cette génération.
JWT_PASSPHRASE=CHANGE_MOI_PHRASE_SECRETE_JWT

# Domaine réel du frontend en production (remplace localhost du fichier .env de dev).
CORS_ALLOW_ORIGIN=^https://amoura\.example\.com$

# Fournisseur transactionnel réel (Mailjet ou SendGrid), jamais Mailpit en production.
MAILER_DSN=mailjet+smtp://PUBLIC_KEY:PRIVATE_KEY@default

# --- Frontend ---
# URL publique de l'API telle qu'accessible depuis le navigateur du client (pas
# le nom du service Docker interne "backend").
VITE_API_URL=https://api.amoura.example.com/api

# --- Étiquette de version (facultatif) ---
# Doit correspondre au tag Git de la release déployée (ex: v1.0.0).
APP_VERSION=v1.0.0
